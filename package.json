{
  "name": "mtg-battle-mode",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace @mtg/web",
    "build:staging": "npm run build --workspace @mtg/web",
    "cloudflare:login": "wrangler login",
    "cloudflare:status": "wrangler whoami",
    "dev": "npm run dev --workspace @mtg/web",
    "dev:worker:game": "wrangler dev --cwd apps/game-worker --config wrangler.toml",
    "dev:worker:import": "wrangler dev --cwd apps/import-worker --config wrangler.toml",
    "deploy:cloudflare": "npm run deploy:cloudflare:import && npm run deploy:cloudflare:game",
    "deploy:cloudflare:check": "npm run deploy:cloudflare:check:game && npm run deploy:cloudflare:check:import",
    "deploy:cloudflare:check:game": "wrangler deploy --cwd apps/game-worker --config wrangler.toml --dry-run",
    "deploy:cloudflare:check:import": "wrangler deploy --cwd apps/import-worker --env=\"\" --config wrangler.toml --dry-run",
    "deploy:cloudflare:check:staging": "npm run deploy:cloudflare:check:staging:game && npm run deploy:cloudflare:check:staging:import",
    "deploy:cloudflare:check:staging:game": "wrangler deploy --cwd apps/game-worker --env staging --config wrangler.toml --dry-run",
    "deploy:cloudflare:check:staging:import": "wrangler deploy --cwd apps/import-worker --env staging --config wrangler.toml --dry-run",
    "deploy:cloudflare:game": "wrangler deploy --cwd apps/game-worker --config wrangler.toml",
    "deploy:cloudflare:import": "wrangler deploy --cwd apps/import-worker --env=\"\" --config wrangler.toml",
    "deploy:cloudflare:staging": "npm run deploy:cloudflare:staging:import && npm run deploy:cloudflare:staging:game",
    "deploy:cloudflare:staging:game": "wrangler deploy --cwd apps/game-worker --env staging --config wrangler.toml",
    "deploy:cloudflare:staging:import": "wrangler deploy --cwd apps/import-worker --env staging --config wrangler.toml",
    "deploy:firebase": "npm run deploy:firebase:hosting",
    "deploy:firebase:hosting": "npm run build && node scripts/write-runtime-config.mjs && firebase deploy --only hosting:production --project mtgbattlearena",
    "deploy:firebase:hosting:staging": "npm run build && node scripts/write-runtime-config.mjs && firebase deploy --only hosting:staging --project mtgbattlearena",
    "deploy:all": "npm run deploy:cloudflare && npm run deploy:firebase",
    "dev:firebase:hosting": "npm run build && node scripts/write-runtime-config.mjs && firebase serve --only hosting:production --project mtgbattlearena",
    "firebase:login": "firebase login",
    "firebase:status": "firebase login:list && firebase use --project mtgbattlearena",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "graphql:codegen": "node scripts/generate-persisted-operations.mjs && graphql-codegen --config codegen.ts",
    "graphql:codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "graphql:codegen:check": "node scripts/check-graphql-generated.mjs",
    "lint:fix": "eslint --fix .",
    "lint:import-worker": "eslint apps/import-worker/src/**/*.ts",
    "lint": "eslint .",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "worker:type-check": "tsc -p apps/game-worker/tsconfig.json --noEmit",
    "preview": "npm run preview --workspace @mtg/web",
    "start": "npm run dev --workspace @mtg/web",
    "test": "npm run test:packages && npm run test:web && npm run test:worker && npm run test:import-worker",
    "test:packages": "vitest --run --config packages/vitest.config.ts",
    "test:web": "vitest --run --config apps/web/vite.config.ts",
    "test:worker": "vitest --run --config apps/game-worker/vitest.config.ts",
    "test:import-worker": "vitest --run apps/import-worker/test",
    "test:integration": "vitest --run --config apps/game-worker/vitest.config.ts test/online-worker.integration.test.ts test/lobby-worker.integration.test.ts test/worker-online.test.ts && vitest --run --config apps/web/vite.config.ts src/features/online/realtime.test.ts src/features/online/OnlineScreen.test.tsx",
    "test:import-worker-config": "node apps/import-worker/scripts/validate-private-config.mjs",
    "type-check": "tsc -b --noEmit",
    "validate:import-worker": "npm run lint:import-worker && npm run test:import-worker-config && npm run deploy:cloudflare:check:staging:import && npm run deploy:cloudflare:check:import"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.5",
    "@graphql-codegen/typescript-rtk-query": "^4.0.4",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/eslint-plugin": "^1.1.39",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "filelist": {
      "minimatch": "10.2.5"
    }
  }
}
