# Alleen lokale developmentfallbacks. Releasebuilds negeren deze waarden en
# krijgen hun endpoints via /runtime-config.js.
# Leeg laten voor de lokale mock-auth en mock-lobby's.
VITE_ONLINE_API_URL=
VITE_ONLINE_SOCKET_URL=
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Lokaal leeg laten om de Vite-proxy te gebruiken. Productie gebruikt de
# publieke API-gateway uit runtime-config.js.
VITE_IMPORT_API_URL=

# Vereist zodra VITE_ONLINE_API_URL is ingesteld. Kopieer deze publieke
# webconfig uit Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APP_CHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=<public-site-key>

# De WebSocket-adapter vraagt per verbinding/reconnect een nieuw eenmalig
# ticket op. Commit nooit private keys, serviceaccounts of toegangstokens.

# De releasegenerator leest onderstaande procesvariabelen. GitHub Actions haalt
# ze uit de geselecteerde GitHub Environment; dit bestand wordt niet automatisch
# door het Node-script geladen.
APP_ENV=
IMPORT_API_URL=
ONLINE_API_URL=
ONLINE_SOCKET_URL=
RELEASE_VERSION=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_APP_CHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=<public-site-key>
RUNTIME_CONFIG_OUTPUT=apps/web/dist/runtime-config.js
