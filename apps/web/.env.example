# Leeg laten voor de lokale mock-auth en mock-lobby's.
VITE_ONLINE_API_URL=

# Vereist zodra VITE_ONLINE_API_URL is ingesteld. Kopieer deze publieke
# webconfig uit Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# De WebSocket-adapter vraagt per verbinding/reconnect een nieuw eenmalig
# ticket op. Commit nooit private keys, serviceaccounts of toegangstokens.
